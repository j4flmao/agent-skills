{
  "$comment": "Skill Combination Advisor tracks. Paths are relative to skills/ and accept * wildcards (matching across folders). Edit, then run: npm run docs",
  "levels": {
    "1": {
      "title": "Level 1 — Essentials",
      "hint": "Install these first. They cover the everyday work of this role and rarely conflict."
    },
    "2": {
      "title": "Level 2 — Professional",
      "hint": "Add when the project grows: production concerns, scaling and team workflows."
    },
    "3": {
      "title": "Level 3 — Specialist",
      "hint": "Add one at a time, only for the problem in front of you. These are deep and narrow."
    }
  },
